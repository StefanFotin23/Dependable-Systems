apiVersion: v1
kind: Service
metadata:
  name: nodered-service
  namespace: default
spec:
  selector:
    app: nodered
  ports:
    - protocol: TCP
      port: 80
      targetPort: 1880
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: nodered-ingress
  namespace: default
{% if not is_wsl %}
  annotations:
    cert-manager.io/cluster-issuer: "selfsigned-issuer"
{% endif %}
spec:
  rules:
  - host: nodered.local
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: nodered-service
            port:
              number: 80
{% if not is_wsl %}
  tls:
  - hosts:
    - nodered.local
    secretName: nodered-tls-secret
{% endif %}
---
{% if not is_wsl %}
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: selfsigned-issuer
spec:
  selfSigned: {}
{% endif %}

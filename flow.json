    {
        "id": "76fcad92c6778f58",
        "type": "function",
        "z": "454db83ef85d1f44",
        "name": "Curățare date RSS",
        "func": "let data = [];\n\ntry {\n    let tari = msg.payload.Prognoza_AdmNatMeteorologie_Romania.tara;\n    tari.forEach(tara => {\n        tara.localitate.forEach(loc => {\n            let oras = loc['$'].nume;\n            loc.prognoza.forEach(p => {\n                data.push({\n                    Oras: oras,\n                    Data: p['$'].data,\n                    TempMin: p.temp_min[0]._ || \"\",\n                    TempMax: p.temp_max[0]._ || \"\",\n                    Fenomen: p.fenomen_descriere ? (p.fenomen_descriere[0]._ || \"\") : \"\",\n                    Simbol: p.fenomen_simbol ? (p.fenomen_simbol[0]._ || \"\") : \"\"\n                });\n            });\n        });\n    });\n} catch(err) {\n    node.warn(\"Error parsing XML: \"+err);\n}\n\nmsg.payload = data;\nflow.set(\"forecastData\", msg.payload);\nreturn msg;\n",

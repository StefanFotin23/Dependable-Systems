    {
        "id": "89a43b751ec5ddbb",
        "type": "function",
        "z": "454db83ef85d1f44",
        "name": "Telemetry",
        "func": "let cityData = msg.payload; // array cu obiectele pentru orasul selectat\n\nlet tempMin = cityData.map(d => Number(d.TempMin));\nlet tempMax = cityData.map(d => Number(d.TempMax));\nlet labels  = cityData.map(d => d.Data);\n\nmsg.payload = [{\n    series: [\"TempMin\", \"TempMax\"],\n    data: [tempMin, tempMax],\n    labels: labels\n}];\n\nlet allTemps = tempMin.concat(tempMax);\nlet rawMin = Math.min(...allTemps);\nlet rawMax = Math.max(...allTemps);\n\nlet yMin = Math.floor(rawMin * 0.9) - 1;\nlet yMax = Math.ceil(rawMax * 1.1) + 1;\n\n// Add chart options for dynamic Y-axis\nmsg.options = {\n    scales: {\n        y: {\n            min: yMin ,\n            max: yMax\n        }\n    }\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

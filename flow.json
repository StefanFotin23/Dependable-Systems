        "func": "let selectedCity = msg.payload; // payload = string selectat din dropdown\nlet allData = flow.get(\"forecastData\") || [];\n\n// dacă e \"All\" sau string gol, nu filtrăm\nif (!selectedCity || selectedCity === \"All\") {\n    msg.payload = allData; // toate datele\n} else {\n    msg.payload = allData.filter(d => d.Oras === selectedCity);\n}\n\nreturn msg;\n",
